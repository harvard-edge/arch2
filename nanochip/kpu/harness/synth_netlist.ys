# yosys full-synthesis flow producing a gate-level Verilog netlist
# (frozen harness file). The nano task keeps this as a hardware-realism
# artifact, but does not re-simulate it. Area and timing are measured by the
# separate synth_area.ys and synth_tech.ys flows.
read_verilog -sv {FILES}
hierarchy -check -top msh_chip_top
synth -top msh_chip_top -noabc
abc -fast
clean
write_verilog -noattr {NETLIST}
