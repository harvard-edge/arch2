# Dependency-only AMD64 preparation. Build context contains the hash-locked
# wheelhouse plus these named lock/verifier files; no Nanochip source installed.
FROM --platform=linux/amd64 hpretl/iic-osic-tools@sha256:872e7e57e31966dead2ae6ed31f6277fb9ec92f20cc66afbb3f39f57b2b1e708
USER 0:0
ENV PATH="/opt/nanochip-venv/bin:${PATH}" \
    USER=nanochip TORCHINDUCTOR_CACHE_DIR=/tmp/nanochip-torch-inductor \
    OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 \
    NANOCHIP_PHYSICAL_MODE=native \
    NANOCHIP_PHYSICAL_IMAGE=hpretl/iic-osic-tools@sha256:ae380e2b0b96bd57b91f5864623ed488d00f78eaf58caf7f7d9d3754d315df38
LABEL org.nanochip.runtime=amd64-dependencies-v1 \
      org.nanochip.physical-base-platform=hpretl/iic-osic-tools@sha256:872e7e57e31966dead2ae6ed31f6277fb9ec92f20cc66afbb3f39f57b2b1e708
COPY requirements-full-amd64.lock /opt/nanochip-runtime/requirements-full.lock
COPY full-runtime-constraints-amd64.txt /opt/nanochip-runtime/full-runtime-constraints.txt
COPY verify_full_runtime.py /opt/nanochip-runtime/verify_full_runtime.py
RUN --network=none --mount=type=bind,source=wheelhouse,target=/wheels,readonly \
    /usr/bin/python3 -m venv --system-site-packages --without-pip /opt/nanochip-venv \
    && /opt/nanochip-venv/bin/python -I -m pip install --no-index --find-links=/wheels \
       --no-deps --require-hashes -r /opt/nanochip-runtime/requirements-full.lock
WORKDIR /work
ENTRYPOINT []
CMD ["/bin/bash"]
