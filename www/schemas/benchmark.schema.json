{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arch2.mlsysbook.ai/schemas/benchmark-registry.v1.schema.json",
  "title": "Architecture 2.0 Benchmark and Workload Registry Entry",
  "type": "object",
  "required": [
    "title",
    "url",
    "categories",
    "description",
    "hardware_domains",
    "primary_metric",
    "artifact_availability",
    "authors",
    "institution"
  ],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Target Workloads",
          "Kernel Autotuning",
          "RTL Generation",
          "Verification & Red-Teaming",
          "Physical Design & EDA",
          "Architecture DSE"
        ]
      }
    },
    "description": {"type": "string", "minLength": 1, "maxLength": 280},
    "hardware_domains": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 36}
    },
    "primary_metric": {"type": "string", "minLength": 1, "maxLength": 120},
    "baseline_comparator": {"type": "string", "minLength": 1, "maxLength": 200},
    "health_audit_note": {"type": "string", "minLength": 1, "maxLength": 280},
    "authors": {"type": "string", "minLength": 1},
    "institution": {"type": "string", "minLength": 1},
    "submitted_by": {"type": "string", "minLength": 1},
    "paper_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "repo_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "dataset_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "order": {"type": "integer", "minimum": 0},
    "artifact_availability": {
      "enum": [
        "runnable",
        "benchmark_available",
        "dataset_available",
        "source_available",
        "paper_only",
        "unverified"
      ]
    },
    "last_verified": {
      "oneOf": [
        {"type": "string", "format": "date"},
        {"type": "null"}
      ]
    },
    "verification_note": {"type": "string", "minLength": 1},
    "tags": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 32}
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"artifact_availability": {"const": "unverified"}},
        "required": ["artifact_availability"]
      },
      "then": {"properties": {"last_verified": {"type": "null"}}},
      "else": {
        "required": ["last_verified"],
        "properties": {"last_verified": {"type": "string", "format": "date"}}
      }
    },
    {
      "if": {
        "properties": {"artifact_availability": {"const": "runnable"}},
        "required": ["artifact_availability"]
      },
      "then": {"required": ["verification_note"]}
    }
  ]
}
