font.family: sans-serif
font.sans-serif: Arimo, Arial, Liberation Sans, Helvetica Neue, Helvetica, DejaVu Sans
pdf.fonttype: 42
ps.fonttype: 42

axes.linewidth: 1.0
axes.labelcolor: 222222
axes.labelsize: 10.0
axes.titlesize: 11.5

font.size: 10.0
legend.fontsize: 9.0
figure.titlesize: 12.0

xtick.color: 222222
ytick.color: 222222
xtick.major.size: 4.0
ytick.major.size: 4.0
xtick.major.width: 0.8
ytick.major.width: 0.8
xtick.labelsize: 9.0
ytick.labelsize: 9.0

grid.color: D7DEE5
grid.linewidth: 0.75
