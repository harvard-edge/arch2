font.family: sans-serif
font.sans-serif: Arial, Helvetica, sans-serif, Arimo, Liberation Sans, Helvetica Neue, DejaVu Sans
pdf.fonttype: 42
ps.fonttype: 42

font.size: 6.5
axes.titlesize: 7.2
axes.titleweight: bold
axes.labelsize: 6.5
axes.labelcolor: 20252B
axes.edgecolor: 20252B
axes.linewidth: 0.7
axes.spines.top: False
axes.spines.right: False

xtick.color: 20252B
ytick.color: 20252B
xtick.major.size: 2.5
ytick.major.size: 2.5
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.labelsize: 5.8
ytick.labelsize: 5.8

legend.fontsize: 5.8
legend.frameon: False
figure.titlesize: 7.5
figure.dpi: 150
figure.figsize: 6.5, 4.017

grid.color: D5DEE3
grid.linewidth: 0.55
