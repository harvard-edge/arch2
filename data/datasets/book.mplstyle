figure.dpi: 300
savefig.dpi: 300
savefig.bbox: tight
savefig.transparent: False
figure.facecolor: white
axes.facecolor: white
axes.labelsize: 11
axes.titlesize: 0
xtick.labelsize: 10
ytick.labelsize: 10
xtick.direction: out
ytick.direction: out
font.family: sans-serif
font.sans-serif: Arial, Liberation Sans, Helvetica Neue, Helvetica, DejaVu Sans
font.size: 11
axes.grid: True
axes.grid.axis: y
grid.color: D7DEE5
grid.linestyle: -
grid.linewidth: 0.8
grid.alpha: 0.8
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.8
